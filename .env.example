# Supabase (backend only — never prefix with VITE_, never commit real values)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Existing SUPABASE_KEY secret/service-role configurations also work.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
CAREERBRIDGE_ENV=development
STORAGE_BUCKET=careerbridge-private
# SQL connection for explicit migrations and transactional intake functions.
DATABASE_URL=

# Backend auth mode: "supabase" (default) validates a Supabase Auth bearer
# token on every request; "header" trusts an X-User-Id header with no
# verification at all — dev/test only, NEVER set this in a deployment.
AUTH_MODE=supabase

# AI backend agent modes — "mock" needs no OpenAI/Keenable keys
CAREERBRIDGE_ANALYST_MODE=mock
CAREERBRIDGE_SEARCH_MODE=mock

# Optional — only needed to run agents in live mode
OPENAI_API_KEY=
OPENAI_MODEL=
NEBIUS_API_KEY=
NEBIUS_MODEL=
KEENABLE_API_KEY=

# Optional server-side tracing; never use VITE_ for these values.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENABLED=true

# Backend CORS
CORS_ORIGINS=http://localhost:3002

# Frontend (Vite)
VITE_USE_MOCKS=false
VITE_API_BASE_URL=http://localhost:8000

# Frontend Supabase Auth — the publishable key is designed to be public
# (never put SUPABASE_KEY here, and never prefix the secret key with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Learning discovery/planning always use live providers and capability checks.
RESOURCE_MODEL_ROUTING_PATH=deployment/resource-model-routing.yaml
PLAN_MODEL_ROUTING_PATH=deployment/plan-model-routing.yaml
LESSON_MODEL_ROUTING_PATH=deployment/lesson-model-routing.yaml
CHECK_MODEL_ROUTING_PATH=deployment/check-model-routing.yaml
